# Copy this file to .env inside each service folder and adjust values.
# Example:
# - api-gateway/.env
# - user-service/.env
# - product-service/.env
# - order-service/.env

# ==========================
# Common settings
# ==========================
NODE_ENV=development
LOG_LEVEL=info
JSON_BODY_LIMIT=100kb
HTTP_TIMEOUT_MS=5000

# ==========================
# API Gateway (.env for api-gateway)
# ==========================
PORT=3000
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002
ORDER_SERVICE_URL=http://order-service:3003
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
CORS_ORIGINS=http://localhost:3000

# ==========================
# User Service (.env for user-service)
# ==========================
PORT=3001

# ==========================
# Product Service (.env for product-service)
# ==========================
PORT=3002

# ==========================
# Order Service (.env for order-service)
# ==========================
PORT=3003
USER_SERVICE_URL=http://user-service:3001
PRODUCT_SERVICE_URL=http://product-service:3002

# ==========================
# JWT settings (if you add auth)
# ==========================
JWT_SECRET=replace_with_strong_random_value
JWT_ISSUER=microservices-nodejs
JWT_AUDIENCE=microservices-clients
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ==========================
# Database settings (example: PostgreSQL)
# ==========================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=microservices
DB_USER=app_user
DB_PASSWORD=change_me
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DATABASE_URL=

# ==========================
# Redis settings
# ==========================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false

# ==========================
# External APIs
# ==========================
EXTERNAL_API_BASE_URL=https://api.example.com
EXTERNAL_API_KEY=replace_with_api_key
EXTERNAL_API_TIMEOUT_MS=5000

# ==========================
# SMTP settings (optional)
# ==========================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_user
SMTP_PASSWORD=your_password
SMTP_SECURE=false
